      "name": "[Write Files] Write Image Files"
    },
    {
      "parameters": {
        "command": "=sh -c 'DIR=/app/images/{{ $json.dirName }} && SDIR=/app/scripts/{{ $json.dirName }} && ls \"$DIR\"/*.jpg | sort | while read f; do printf \"file '\\''%s'\\''\\nduration 3\\n\" \"$f\"; done > \"$DIR\"/concat.txt && tail -2 \"$DIR\"/concat.txt | head -1 >> \"$DIR\"/concat.txt && ffmpeg -y -f concat -safe 0 -i \"$DIR\"/concat.txt -vf \"scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2,subtitles=$SDIR/subtitles.srt:force_style='\\''FontSize=24,PrimaryColour=&Hffffff&'\\''\" -c:v libx264 -pix_fmt yuv420p -r 30 /app/videos/{{ $json.dirName }}/shorts.mp4'"
      },
