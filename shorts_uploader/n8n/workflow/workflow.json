      ],
      "id": "942d32c9-3aff-4c04-b036-5ffacd6a3bfe",
      "name": "[Code] Parsing Text & Title"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "=다음 뉴스 기사를 이미지 슬라이드 영상의 자막으로 사용할 수 있도록 요약해줘.\n\n제목: {{ $json.title }}\n본문: {{ $json.text }}\n\n조건:\n- 이미지 1장당 1문장씩, 총 2문장으로 요약\n- 각 문장은 30자 이내\n- JSON 배열로 출력 (예: [\"문장1\", \"문장2\"])\n- 다른 설명 없이 JSON만 출력"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [
        840,
        -100
      ],
      "id": "96852c89-e31b-4397-86a4-ec307df379f8",
      "name": "[OpenAI] Create Subtitles",
      "credentials": {
        "openAiApi": {
          "id": "EVuyairK9SEpQ1xK",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const content = $input.first().json.message.content;\nconst subtitles = JSON.parse(content);\nconst dirName = $('Webhook').first().json.body.article_id;\n\nlet srt = '';\nfor (let i = 0; i < subtitles.length; i++) {\n  const start = i * 3;\n  const end = start + 3;\n  const startTime = `00:00:0${start},000`;\n  const endTime = `00:00:0${end},000`;\n  srt += `${i + 1}\\n${startTime} --> ${endTime}\\n${subtitles[i]}\\n\\n`;\n}\nreturn [{\n  json: { fileName: 'subtitles.srt', dirName },\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      Buffer.from(srt, 'utf-8'),\n      'subtitles.srt',\n      'text/plain'\n    ),\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        -100
      ],
      "id": "92e47367-5bc0-40cb-8c7e-df049b1e2319",
      "name": "[Code] Parsing Subtitles"
    },
