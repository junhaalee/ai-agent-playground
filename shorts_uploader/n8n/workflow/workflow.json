{
  "name": "My workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const imageUrls = $('Webhook').first().json.body.image;\nconst dirName = $('Webhook').first().json.body.article_id;\n\nconst results = [];\nfor (let i = 0; i < imageUrls.length; i++) {\n  const response = await this.helpers.httpRequest({\n    method: 'GET',\n    url: imageUrls[i],\n    encoding: 'arraybuffer',\n    returnFullResponse: true,\n  });\n  const fileName = `image_${i + 1}.jpg`;\n  results.push({\n    json: { fileName, dirName, url: imageUrls[i], status: 'downloaded' },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        Buffer.from(response.body),\n        fileName,\n        'image/jpeg'\n      ),\n    },\n  });\n}\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        140
      ],
      "id": "05460960-3837-4b71-a392-bfb8c9c3e38f",
      "name": "[Code] Parsing Image Url"
    },
    {
      "parameters": {
        "jsCode": "const title = $('Webhook').first().json.body.title;\nconst text = $('Webhook').first().json.body.text;\nconst dirName = $('Webhook').first().json.body.article_id;\n\nreturn [{\n  json: {\n    title: title,\n    text: text,\n    dirName\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
